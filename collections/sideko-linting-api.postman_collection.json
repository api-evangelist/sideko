      },
      "item": [
        {
          "id": "7a55bd32-6a4f-4a23-83af-9e8516dd9975",
          "name": "Lint API Project",
          "request": {
            "name": "Lint API Project",
            "description": {
              "content": "Runs Sideko's OpenAPI linting rules against a project version and returns any blocking or advisory linting errors that would prevent SDK, MCP, or mock generation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api-projects",
                ":projectId",
                "lint"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "projectId",
                  "description": "(Required) Unique identifier of the API project"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"versionId\": \"<uuid>\",\n  \"errorsOnly\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
